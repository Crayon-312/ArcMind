+function scoreRelationships(documents, directScores) {
+  const paths = new Set(documents.map((document) => document.path));
+  const scores = new Map();
+  for (const document of documents) {
+    const sourceScore = directScores.get(document.path) ?? 0;
+    for (const target of document.links ?? []) {
+      if (!paths.has(target)) continue;
+      const targetScore = directScores.get(target) ?? 0;
+      if (sourceScore > 0) addRelationshipScore(scores, target, sourceScore);
+      if (targetScore > 0) addRelationshipScore(scores, document.path, targetScore);
+    }
+  }
+  return scores;
+}
+
+function addRelationshipScore(scores, path, directScore) {
+  const bonus = Math.min(3, Math.max(1, Math.ceil(directScore / 8)));
+  scores.set(path, Math.max(scores.get(path) ?? 0, bonus));
+}
+
+function scoreStatus(status) {
+  if (status === "current") return 3;
+  if (status === "deprecated" || status === "stale") return -2;
