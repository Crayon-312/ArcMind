{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcmind.invalid/schemas/response-event.schema.json",
  "title": "ArcMind response event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "response_id",
    "sequence",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": [
        "response.started",
        "response.snapshot",
        "response.delta",
        "response.completed",
        "response.failed",
        "response.cancelled",
        "heartbeat"
      ]
    },
    "response_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.snapshot" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "snapshot_version"],
            "properties": {
              "text": { "type": "string", "maxLength": 200000 },
              "snapshot_version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.delta" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 200000 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.completed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn_id", "response_version"],
            "properties": {
              "turn_id": { "type": "string", "format": "uuid" },
              "response_version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.failed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["error_code", "retryable", "correlation_id"],
            "properties": {
              "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
              "retryable": { "type": "boolean" },
              "correlation_id": { "type": "string", "minLength": 8, "maxLength": 128 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.cancelled" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cancelled_by", "response_version"],
            "properties": {
              "cancelled_by": { "type": "string", "enum": ["user", "session_revoked", "system"] },
              "response_version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "heartbeat" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["server_time"],
            "properties": {
              "server_time": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "response.started" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
