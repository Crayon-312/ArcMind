[Unit]
Description=Check ArcMind public certificate lifetime
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/arcmind/.env
ExecStart=/opt/arcmind/operations/check-certificate.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
