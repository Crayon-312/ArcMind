ARCMIND_ENVIRONMENT=development
ARCMIND_DATABASE_URL=postgresql+psycopg://arcmind:replace-me@127.0.0.1:5432/arcmind
ARCMIND_PUBLIC_ORIGIN=https://127.0.0.1
ARCMIND_ALLOWED_EMAIL=owner@example.com
ARCMIND_PROOF_SECRET=replace-with-at-least-32-random-characters
ARCMIND_SMTP_HOST=127.0.0.1
ARCMIND_SMTP_PORT=1025
ARCMIND_SMTP_FROM=ArcMind <no-reply@arcmind.invalid>
ARCMIND_SMTP_USERNAME=
ARCMIND_SMTP_PASSWORD=
ARCMIND_SMTP_STARTTLS=false
ARCMIND_SMTP_SSL=false
ARCMIND_SMTP_TIMEOUT_SECONDS=10
ARCMIND_DEEPSEEK_API_KEY=
ARCMIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
ARCMIND_DEEPSEEK_MODEL=deepseek-v4-pro
ARCMIND_DEEPSEEK_TIMEOUT_SECONDS=60
ARCMIND_COOKIE_SECURE=true
